<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>BayControl</AssemblyName>
    <RootNamespace>BayControl.Host</RootNamespace>
    <Product>Bay Control</Product>
    <Version>1.3.2</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Zeroconf" Version="3.7.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\profiles\**\*" Link="profiles\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\web\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\web\index.html')" />
    <Content Include="..\web\app.js" Link="wwwroot\app.js" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\web\app.js')" />
    <Content Include="..\web\styles.css" Link="wwwroot\styles.css" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\web\styles.css')" />
    <Content Include="..\web\manifest.webmanifest" Link="wwwroot\manifest.webmanifest" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\web\manifest.webmanifest')" />
    <Content Include="..\web\icon.svg" Link="wwwroot\icon.svg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\web\icon.svg')" />
    <Content Include="..\INSTALL.txt" Link="INSTALL.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\INSTALL.txt')" />
    <Content Include="..\Install-BayControl.ps1" Link="Install-BayControl.ps1" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Install-BayControl.ps1')" />
  </ItemGroup>

  <!-- Exclude leftover WPF template files if present -->
  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="AssemblyInfo.cs" />
    <Page Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

</Project>
