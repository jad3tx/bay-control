{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baycontrol.local/profiles/schema.json",
  "title": "BayControlSimProfile",
  "type": "object",
  "required": ["id", "displayName", "processNames", "actions"],
  "properties": {
    "id": { "type": "string" },
    "displayName": { "type": "string" },
    "processNames": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "windowTitleContains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "label": { "type": "string" },
          "group": { "type": "string" },
          "holdMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
